# Written by `npx convex dev` on first run
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Same as NEXT_PUBLIC_CONVEX_URL but ending in .convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" shows the Google button (needs GOOGLE_* set on Convex below)
NEXT_PUBLIC_GOOGLE_AUTH=false

# Set these on the Convex deployment, not in .env.local:
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL http://localhost:3000
# Optional (enables Google sign-in):
#   npx convex env set GOOGLE_CLIENT_ID ...
#   npx convex env set GOOGLE_CLIENT_SECRET ...
# Optional (enables password reset and order emails):
#   npx convex env set RESEND_API_KEY ...
#   npx convex env set EMAIL_FROM "YOD <hello@your-domain.com>"
